<script>
(function () {
    if (!window.vzoTheme) {
        return;
    }

    var labels = {
        light: {
            label: 'Светлая тема',
            button: 'Тема: светлая. Переключить на темную'
        },
        dark: {
            label: 'Темная тема',
            button: 'Тема: темная. Переключить на светлую'
        }
    };

    function normalizeTheme(theme) {
        return theme === 'dark' ? 'dark' : 'light';
    }

    function getControls() {
        return Array.prototype.slice.call(document.querySelectorAll('[data-theme-control]'));
    }

    function getCurrentTheme() {
        if (typeof window.vzoTheme.getTheme === 'function') {
            return normalizeTheme(window.vzoTheme.getTheme());
        }

        return normalizeTheme(window.vzoTheme.apply(window.vzoTheme.getChoice()).theme);
    }

    function syncControl(control, state) {
        var theme = normalizeTheme(state.theme);
        var trigger = control.querySelector('[data-theme-trigger]');
        var label = control.querySelector('[data-theme-label]');
        var meta = labels[theme];

        control.setAttribute('data-theme-choice', theme);
        control.setAttribute('data-theme-effective', theme);

        if (trigger) {
            trigger.setAttribute('aria-label', meta.button);
            trigger.setAttribute('title', meta.button);
            trigger.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
        }

        if (label) {
            label.textContent = meta.label;
        }
    }

    function syncControls(state) {
        getControls().forEach(function (control) {
            syncControl(control, state);
        });
    }

    function toggleTheme(control) {
        var currentTheme = normalizeTheme(control.getAttribute('data-theme-effective') || getCurrentTheme());
        var nextTheme = currentTheme === 'dark' ? 'light' : 'dark';

        syncControls(window.vzoTheme.setChoice(nextTheme));
    }

    function bindControl(control) {
        if (control.getAttribute('data-theme-bound') === 'true') {
            return;
        }

        control.setAttribute('data-theme-bound', 'true');

        var trigger = control.querySelector('[data-theme-trigger]');
        if (!trigger) {
            return;
        }

        trigger.addEventListener('click', function () {
            toggleTheme(control);
        });
    }

    function initThemeControls() {
        getControls().forEach(bindControl);
        syncControls(window.vzoTheme.apply(window.vzoTheme.getChoice()));
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initThemeControls);
    } else {
        initThemeControls();
    }

    window.vzoTheme.onChange(syncControls);
})();
</script>
