    <script>
        // Page-path cookie for card-click attribution (SEO Block B).
        // Client-side on purpose: server HTML stays microcache-able, while the
        // cookie carries the per-visitor page path to the redirect endpoint,
        // where the HTTP Referer is often absent for organic/`rel=noreferrer` clicks.
        (function () {
            try {
                var path = window.location.pathname || '/';
                var attrs = '; path=/; max-age=7200; SameSite=Lax';
                document.cookie = 'VZO_PAGE_PATH=' + encodeURIComponent(path) + attrs;
                if (document.cookie.indexOf('VZO_LANDING_PATH=') === -1) {
                    document.cookie = 'VZO_LANDING_PATH=' + encodeURIComponent(path) + attrs;
                }
            } catch (e) { /* never break rendering */ }
        })();
    </script>
    <meta name="theme-color" content="#ffffff" data-theme-color>
    <script>
(function () {
    if (window.vzoTheme && window.vzoTheme.ready) {
        return;
    }

    var storageKey = 'theme';
    var darkQuery = '(prefers-color-scheme: dark)';
    var choices = ['system', 'light', 'dark'];
    var defaultChoice = 'system'; // vzo2 (20260721): первый визит — по prefers-color-scheme; явный выбор пользователя сохраняется
    var themeColors = {
        light: '#ffffff',
        dark: '#0b1117'
    };
    var callbacks = [];

    function normalizeChoice(choice) {
        return choices.indexOf(choice) !== -1 ? choice : defaultChoice;
    }

    function getMedia() {
        return window.matchMedia ? window.matchMedia(darkQuery) : null;
    }

    function getSystemTheme() {
        var media = getMedia();
        return media && media.matches ? 'dark' : 'light';
    }

    function getStoredChoice() {
        try {
            return normalizeChoice(window.localStorage.getItem(storageKey));
        } catch (error) {
            return defaultChoice;
        }
    }

    function resolveTheme(choice) {
        choice = normalizeChoice(choice);
        return choice === 'system' ? getSystemTheme() : choice;
    }

    function updateThemeColor(theme) {
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
            meta.setAttribute('content', themeColors[theme]);
        }
    }

    function syncBody(theme) {
        if (document.body) {
            document.body.classList.toggle('dark-mode', theme === 'dark');
        }
    }

    function emit(state) {
        callbacks.forEach(function (callback) {
            callback(state);
        });
    }

    function applyTheme(choice) {
        choice = normalizeChoice(choice);

        var theme = resolveTheme(choice);
        var root = document.documentElement;
        var state = {
            choice: choice,
            theme: theme
        };

        root.setAttribute('data-theme-choice', choice);
        root.setAttribute('data-theme', theme);
        root.style.colorScheme = theme;
        window.vzoThemeState = state;

        syncBody(theme);
        updateThemeColor(theme);
        emit(state);

        return state;
    }

    function setChoice(choice) {
        choice = normalizeChoice(choice);

        try {
            window.localStorage.setItem(storageKey, choice);
        } catch (error) {}

        return applyTheme(choice);
    }

    window.vzoTheme = {
        ready: true,
        storageKey: storageKey,
        apply: applyTheme,
        setChoice: setChoice,
        getChoice: getStoredChoice,
        getTheme: function () {
            return (window.vzoThemeState && window.vzoThemeState.theme) || resolveTheme(getStoredChoice());
        },
        onChange: function (callback) {
            if (typeof callback === 'function') {
                callbacks.push(callback);
            }
        }
    };

    applyTheme(getStoredChoice());

    document.addEventListener('DOMContentLoaded', function () {
        applyTheme(getStoredChoice());
    });

    var media = getMedia();
    if (media) {
        var onSystemThemeChange = function () {
            if (getStoredChoice() === 'system') {
                applyTheme('system');
            }
        };

        if (media.addEventListener) {
            media.addEventListener('change', onSystemThemeChange);
        } else if (media.addListener) {
            media.addListener(onSystemThemeChange);
        }
    }
})();
</script>
