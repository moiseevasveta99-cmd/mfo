(function () {
    var placeholders = document.querySelectorAll('[data-iframe-src]');
    if (!placeholders.length) return;
    function loadIframe(placeholder) {
        var src = placeholder.getAttribute('data-iframe-src');
        if (!src) return;
        var iframe = document.createElement('iframe');
        iframe.className = placeholder.className;
        iframe.src = src;
        var label = placeholder.getAttribute('aria-label');
        if (label) iframe.title = label;
        iframe.setAttribute('loading', 'lazy');
        if (placeholder.parentNode) {
            placeholder.parentNode.replaceChild(iframe, placeholder);
        }
    }
    if (!('IntersectionObserver' in window)) {
        for (var i = 0; i < placeholders.length; i++) loadIframe(placeholders[i]);
        return;
    }
    var observer = new IntersectionObserver(function (entries, obs) {
        entries.forEach(function (entry) {
            if (entry.isIntersecting) {
                obs.unobserve(entry.target);
                loadIframe(entry.target);
            }
        });
    }, { rootMargin: '200px 0px' });
    for (var j = 0; j < placeholders.length; j++) observer.observe(placeholders[j]);
})();
</script>
